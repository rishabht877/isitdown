{
  "name": "isitdown",
  "version": "1.0.0",
  "description": "A community outage board for public APIs",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "seed": "npm run seed:services && npm run seed:incidents",
    "seed:services": "node --env-file=.env scripts/seed-services.js",
    "seed:incidents": "node --env-file=.env scripts/seed-incidents.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "author": "Rishabh Tiwari",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  }
}
